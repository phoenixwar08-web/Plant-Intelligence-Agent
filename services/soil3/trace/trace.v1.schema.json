{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "created_at",
    "updated_at",
    "decision",
    "execution",
    "feedback_refs",
    "outcome_ref"
  ],
  "properties": {
    "schema_version": {"const": "trace.v1"},
    "trace_id": {"type": "string", "pattern": "^tr-[0-9a-f]{24}$"},
    "created_at": {"$ref": "#/$defs/rfc3339_utc"},
    "updated_at": {"$ref": "#/$defs/rfc3339_utc"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_ref", "vision", "experience", "model_metrics", "strategy_ref",
        "gate_ref", "gate_decision", "gate_reason_codes", "runner_ref",
        "bridge_ref", "episode_ref"
      ],
      "properties": {
        "state_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_ref"}]},
        "vision": {"$ref": "#/$defs/association"},
        "experience": {"$ref": "#/$defs/association"},
        "model_metrics": {"$ref": "#/$defs/model_metrics"},
        "strategy_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_ref"}]},
        "gate_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_ref"}]},
        "gate_decision": {"type": ["null", "string"], "enum": [null, "allow", "allow_with_warning", "deny"]},
        "gate_reason_codes": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "string", "minLength": 1}}]},
        "runner_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_ref"}]},
        "bridge_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_ref"}]},
        "episode_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_ref"}]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase3_called", "physical_actions_performed"],
      "properties": {
        "phase3_called": {"const": false},
        "physical_actions_performed": {"const": false}
      }
    },
    "feedback_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/record_ref"}},
    "outcome_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_ref"}]}
  },
  "$defs": {
    "rfc3339_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "path", "sha256", "record_id"],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_id": {"type": ["null", "string"], "minLength": 1}
      }
    },
    "association": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "ref"],
          "properties": {
            "availability": {"const": "available"},
            "ref": {"$ref": "#/$defs/record_ref"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "ref"],
          "properties": {
            "availability": {"enum": ["unavailable", "not_requested"]},
            "ref": {"type": "null"}
          }
        }
      ]
    },
    "model_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "token_usage", "cost", "latency"],
      "properties": {
        "provider": {"type": ["null", "string"], "minLength": 1},
        "model": {"type": ["null", "string"], "minLength": 1},
        "token_usage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/token_metric"}]},
        "cost": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/cost_metric"}]},
        "latency": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/latency_metric"}]}
      }
    },
    "token_metric": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "value", "unit"],
      "properties": {"source": {"const": "provider_response.usage"}, "value": {"type": "number", "minimum": 0}, "unit": {"const": "tokens"}}
    },
    "cost_metric": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "value", "unit"],
      "properties": {"source": {"const": "provider_response.billing"}, "value": {"type": "number", "minimum": 0}, "unit": {"const": "CNY"}}
    },
    "latency_metric": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "value", "unit"],
      "properties": {"source": {"const": "runtime_monotonic_clock"}, "value": {"type": "number", "minimum": 0}, "unit": {"const": "ms"}}
    }
  }
}
