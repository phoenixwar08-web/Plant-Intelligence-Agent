{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-agent.local/schemas/strategy.v1.schema.json",
  "title": "soil3 Strategy V1",
  "type": "object",
  "required": [
    "schema_version",
    "strategy_id",
    "state_id",
    "plant_id",
    "created_at",
    "actions",
    "reason_summary",
    "expected_outcome",
    "confidence",
    "model",
    "execution"
  ],
  "properties": {
    "schema_version": {"const": "strategy.v1"},
    "strategy_id": {"type": "string", "format": "uuid"},
    "state_id": {"type": "string"},
    "plant_id": {"const": "soil3"},
    "created_at": {"type": "string", "format": "date-time"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["action_id", "type", "pump_seconds"],
            "properties": {
              "action_id": {"type": "string", "minLength": 1},
              "type": {"const": "water"},
              "pump_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["action_id", "type", "seconds"],
            "properties": {
              "action_id": {"type": "string", "minLength": 1},
              "type": {"const": "wait"},
              "seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["action_id", "type"],
            "properties": {
              "action_id": {"type": "string", "minLength": 1},
              "type": {"enum": ["observe", "stop"]}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "reason_summary": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
    "expected_outcome": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model": {
      "type": "object",
      "required": ["provider", "name", "prompt_version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "prompt_version": {"const": "strategy-prompt.v1"}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["mode", "actuator_commands_allowed"],
      "properties": {
        "mode": {"const": "proposal_only"},
        "actuator_commands_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
