# Copy this file to a deployment-local location outside Git, then replace only
# the placeholders needed by an independently approved local deployment.
# Never point an exploratory checkout at production MQTT, GaussDB, or devices.

# Optional Plant Agent vision credential. Never commit a real value.
PLANT_VISION_API_KEY=<set-outside-git>

# Optional Phase3 alert credential. Never commit a real value.
IRRIGATION_ALERT_SMTP_PASS=<set-outside-git>

# Phase2 supports a JSON configuration file outside this repository.
WYC_PHASE2_CONFIG=<absolute-path-outside-repository>/phase2-config.json

# Keep disabled unless a least-privilege database deployment has been reviewed.
PLANT_AGENT_DB_LEAST_PRIVILEGE=0
