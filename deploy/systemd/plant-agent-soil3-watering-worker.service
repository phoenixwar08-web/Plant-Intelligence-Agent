[Unit]
Description=Prepare AI proposal for one explicit soil3 watering request
After=plant-agent-soil3-watering-worker.path

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/water/releases/plant-intelligence-release
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/root/water/releases/plant-intelligence-release
EnvironmentFile=-/root/water/runtime/instances/soil3/agent_chain/secrets/qwen.env
EnvironmentFile=/root/water/runtime/secrets/vision.test.env
EnvironmentFile=/root/water/runtime/instances/soil3/agent_chain/config/vision_soil3_20260921.env
ExecStart=/root/water/runtime/venvs/soil3-vision/bin/python -m services.soil3.agent_runtime.service watering --config /root/water/runtime/instances/soil3/agent_chain/config/runtime.json --request-dir /root/water/runtime/instances/soil3/agent_chain/watering_requests
TimeoutStartSec=300
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/root/water
ReadWritePaths=/root/water/runtime/instances/soil3/agent_chain
ReadWritePaths=/root/water/data/soil3/vision
BindReadOnlyPaths=-/tmp/.s.PGSQL.7654
